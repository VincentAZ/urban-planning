{
  "name": "urban-planning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/api/src/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "data:phoenix": "tsx scripts/ingest-phoenix.ts",
    "build:media": "tsx scripts/build-media.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/maplibre": "^9.4.1",
    "@deck.gl/mesh-layers": "^9.4.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-query": "^5.90.0",
    "@turf/turf": "^7.3.0",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.16.0",
    "nodemailer": "10.3.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "saxes": "5.0.1",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
