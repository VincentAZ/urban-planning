# Copy to .env for local use. Node 22 loads this file before starting the API.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# For PostgreSQL, provision separate restricted runtime logins and run operator migrations first.
# See docs/STORAGE.md; never use the table owner as DATABASE_URL.
# DATABASE_URL=postgresql://restricted-web-login:private-password@host/database
# DATABASE_AUTH_URL=postgresql://restricted-auth-login:private-password@host/database
# DATABASE_WORKER_URL=postgresql://restricted-worker-login:private-password@host/database
# Operator-only process/environment, never the deployed application:
# DATABASE_MIGRATION_URL=postgresql://migration-owner:private-password@host/database
# DATABASE_WEB_ROLE=urban_app_web
# DATABASE_AUTH_ROLE=urban_app_auth
# DATABASE_WORKER_ROLE=urban_app_worker
# Without DATABASE_URL, development uses .local/api-state.json.sqlite.
# Existing .local/api-state.json is verified/migrated and preserved unchanged; stop older writers first.
# Production refuses this development fallback. See docs/STORAGE.md for migration and recovery.
# Set a private state file path for isolated development instances.
# LOCAL_STATE_PATH=.local/api-state.json
# Production requires https APP_ORIGIN and all three restricted database connections.
# Platform budget admin is a separate trusted user-ID allowlist, never every organization owner.
# Register your own account, verify its ID using the trusted server CLI, then configure it.
# PostgreSQL also requires applying operator migrations with the same allowlist before restart:
# corepack pnpm exec tsx apps/api/src/budget-admin.ts --email your-email@example.com
# PLATFORM_ADMIN_USER_IDS=verified-existing-user-id
# Budget defaults: $300/month USD, $30 safety margin, paid operations paused.
# No paid provider is activated by these settings. Configure provider-side limits separately.
# Bounded national ZCTA preparation is enabled in development, disabled in production by default.
# Explicit production pilot opt-in only; public Overpass is not a national-scale application backend.
# NATIONAL_PUBLIC_PREPARATION_ENABLED=false
# New preparation also needs a fresh administrator cost review and a trusted capacity declaration.
# Use deployment for hosted processing; local-development is accepted only outside production.
# NATIONAL_CAPACITY_ENVIRONMENT=deployment
# NATIONAL_CAPACITY_STATEMENT=Existing fixed hosting capacity covers this bounded worker with no incremental provider charge.
# PUBLIC_SOURCE_CACHE_PATH=.local/public-source-cache
# Census community context uses the prepared ACS public-summary cache when no API key is configured.
# An optional free Census API key must stay server-side:
# CENSUS_API_KEY=your-private-server-side-key
# Regional workforce jobs are opt-in and disabled by default. Visitors are not billed.
# Prepare and verify sources/graph separately; see docs/ROUTING.md and apps/api/README.md.
# PostgreSQL requires operator migrations 004/005 before this worker is enabled.
WORKFORCE_ENABLED=false
# Trusted operator paths only; never accept these values from a browser request.
# WORKFORCE_PACK_PATH=/absolute/path/to/content-hash-named-cohort-pack.json
# WORKFORCE_BOUNDARY_PATH=/absolute/path/to/verified-region-boundary.json
# WORKFORCE_MANIFEST_PATH=/absolute/path/to/captured-routing-manifest.json
# WORKFORCE_ROUTER_URL=http://127.0.0.1:8002
# WORKFORCE_ARCHIVE_DIR=/absolute/path/to/private-persistent-routing-archive
# Declare existing fixed capacity explicitly, and record/reserve its hosting costs in the owner budget.
# Safe budget headroom and unpaused processing are required; no paid provider is enabled.
# WORKFORCE_CAPACITY_ENVIRONMENT=deployment
# WORKFORCE_CAPACITY_STATEMENT=Describe the operator-verified existing fixed routing capacity here.
# Isolated QA may explicitly use local-development; this is not production cost validation.
# The worker does not meter hosting invoices or guarantee an external $300/month bill cap.
# Geographic uploads and Shapefile exports are opt-in, private and free to users.
# Install the exact offline GDAL image and run migrations 006/007 first; see docs/GIS_RUNTIME.md.
GIS_ENABLED=false
# GIS_ARCHIVE_DIR=/absolute/path/to/private-persistent-gis-archive
# GIS_WORK_DIR=/absolute/path/to/private-temporary-gis-work
# GIS_CAPACITY_ENVIRONMENT=deployment
# GIS_CAPACITY_STATEMENT=Describe the verified fixed GIS conversion capacity and its reserved hosting cost.
# Isolated local testing can explicitly use local-development. Keep this worker off until configured.
# The same administrator budget pause/headroom controls apply. No per-query provider is invoked.
# Cloud credentials, licensed data keys, Cognito SSO, and AI integration are not provisioned by this file.
# Native paired traffic experiments are opt-in and free to users; migrations 009/010 are required.
# The operator registry binds each native graph to one exact complete study geometry. See docs/TRAFFIC_RUNTIME.md.
TRAFFIC_ENABLED=false
# TRAFFIC_NETWORK_REGISTRY=/absolute/path/to/private-traffic/registry.json
# TRAFFIC_ARCHIVE_DIR=/absolute/path/to/private-persistent-traffic-archive
# TRAFFIC_WORK_DIR=/absolute/path/to/private-temporary-traffic-work
# TRAFFIC_CAPACITY_ENVIRONMENT=deployment
# TRAFFIC_CAPACITY_STATEMENT=Describe the verified existing traffic capacity and its reserved hosting cost.
# The shared native slot admits only one traffic, GIS or workforce attempt at a time.
# Abandoned or unconfirmed native processes quarantine the slot until trusted operator recovery.

# Free account verification/recovery/invitations; no external email until explicitly enabled.
# Apply migrations 011/012 before rollout; see apps/api/README.md.
IDENTITY_EMAIL_ENABLED=false
# APP_ORIGIN must be a canonical HTTPS origin when email is enabled.
# IDENTITY_EMAIL_FROM=verified-sender@example.com
# IDENTITY_SMTP_HOST=smtp.provider.example
# IDENTITY_SMTP_PORT=587
# IDENTITY_SMTP_USER=private-smtp-user
# IDENTITY_SMTP_PASSWORD=private-smtp-password
# Generate two independent 32-byte cryptographic keys, base64 encoded, and store privately.
# IDENTITY_EMAIL_KEY_ID=primary
# IDENTITY_EMAIL_KEY=private-base64-key
# IDENTITY_EMAIL_RECIPIENT_KEY=separate-stable-private-base64-key
# Rotation: retain old key IDs/values until their queued messages are gone. JSON object, server only.
# IDENTITY_EMAIL_PREVIOUS_KEYS={"old-id":"old-private-base64-key"}
# Required upper bound per attempt in integer USD cents; use the actual provider's terms.
# IDENTITY_EMAIL_MAX_ATTEMPT_CENTS=1
# Uncertain charges remain reserved until invoice reconciliation; hosting/subscription fees need their own reserve.
# IDENTITY_EMAIL_QUEUE_LIMIT=500
# IDENTITY_EMAIL_DAILY_LIMIT=500
# IDENTITY_EMAIL_RECIPIENT_DAILY_LIMIT=10
# IDENTITY_EMAIL_RECIPIENT_COOLDOWN_SECONDS=60

# Optional outbound primary-job accessibility; disabled until all operator assets/capacity are configured.
ACCESSIBILITY_ENABLED=false
# ACCESSIBILITY_PACK_PATH=/absolute/path/to/jobs-content-hash.json
# ACCESSIBILITY_BOUNDARY_PATH=/absolute/path/to/verified-census-state-boundary.json
# ACCESSIBILITY_MANIFEST_PATH=/absolute/path/to/captured-routing-manifest.json
# ACCESSIBILITY_ROUTER_URL=http://127.0.0.1:8002
# ACCESSIBILITY_ARCHIVE_DIR=/absolute/path/to/private-persistent-accessibility-archive
# Record actual fixed hosting commitments in the budget; this is not a metered cost estimate.
# ACCESSIBILITY_CAPACITY_ENVIRONMENT=deployment
# ACCESSIBILITY_CAPACITY_STATEMENT=Describe the operator-verified existing fixed routing capacity here.

# Optional cached effective FEMA NFHL datasets, free and anonymous to read.
# No live provider request occurs at API startup or in ordinary editing.
# Prepare new immutable packs and explicitly install their authority with the migration owner first.
# See apps/api/README.md; apply migrations 015/016. Unset means no available public catalog.
# FLOOD_CATALOG=/absolute/path/to/flood/catalog.json

# Optional isolated PNG/MP4 exports. Disabled by default; never downloads an image.
# Build the renderer and install a pinned image explicitly (see docs/MEDIA.md).
MEDIA_ENABLED=false
MEDIA_IMAGE_ID=
MEDIA_RENDERER_DIRECTORY=
MEDIA_WORK_ROOT=.local/media/work
MEDIA_ARCHIVE_DIRECTORY=.local/media/private-archive
# Must be local-development or deployment with an explicit operator statement.
# Deployment also needs a recorded/reserved fixed hosting cost and a fresh budget review.
MEDIA_CAPACITY_ENVIRONMENT=
MEDIA_CAPACITY_STATEMENT=
